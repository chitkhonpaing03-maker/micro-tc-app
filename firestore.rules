rules_version='2';service cloud.firestore{match /databases/{database}/documents{function signed(){return request.auth!=null;}function u(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}function admin(){return signed()&&u().data.role=='admin';}match /users/{id}{allow read:if signed()&&(id==request.auth.uid||admin());allow create,update:if signed()&&(id==request.auth.uid||admin());allow delete:if admin();}match /settings/{id}{allow read:if signed();allow write:if admin();}match /auditLogs/{id}{allow read:if admin();allow create:if signed();allow update,delete:if admin();}match /students/{id}{allow read,create:if signed();allow update:if signed();allow delete:if admin();}match /courses/{id}{allow read:if signed();allow create,update:if signed();allow delete:if admin();}match /staff/{id}{allow read:if signed();allow write:if admin();}match /batches/{id}{allow read:if signed();allow create,update:if signed();allow delete:if admin();}match /attendance/{id}{allow read,write:if signed();allow delete:if admin();}match /transactions/{id}{allow read:if signed();allow create:if signed();allow update,delete:if admin();}match /approvals/{id}{allow read,create:if signed();allow update:if admin();allow delete:if admin();}match /studentCodes/{id}{allow read,write:if signed();allow delete:if admin();}match /departments/{id}{allow read:if signed();allow write:if admin();}match /{document=**}{allow read,write:if false;}}}
