rules_version='2';service firebase.storage{match /b/{bucket}/o{function signed(){return request.auth!=null;}function admin(){return signed()&&firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role=='admin';}match /branding/{all=**}{allow read:if signed();allow write:if admin()&&request.resource.size<2*1024*1024&&request.resource.contentType.matches('image/.*');}match /staff/{uid}/{all=**}{allow read:if signed();allow write:if admin()||(signed()&&uid==request.auth.uid);}match /{all=**}{allow read:if signed();allow write:if false;}}}
